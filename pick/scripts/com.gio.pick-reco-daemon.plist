<?xml version="1.0" encoding="UTF-8"?>
<!-- pick 추천 로컬 데몬 — launchd KeepAlive 상주. 설치:
       cp pick/scripts/com.gio.pick-reco-daemon.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.gio.pick-reco-daemon.plist
     해제: launchctl unload ~/Library/LaunchAgents/com.gio.pick-reco-daemon.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gio.pick-reco-daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/gio_c/apps/pick/scripts/pick-reco-daemon.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/gio_c/apps/pick</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/gio_c/.local/state/pick-reco-daemon/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/gio_c/.local/state/pick-reco-daemon/stderr.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>/Users/gio_c</string>
  </dict>
</dict>
</plist>
